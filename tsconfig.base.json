{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@aws-nx-poc/source"],
    "rootDir": ".",
    "paths": {
      ":aws-nx-poc/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ],
      ":aws-nx-poc/game-api": ["./packages/game-api/src/index.ts"],
      ":aws-nx-poc/inventory": ["./packages/inventory/src/index.ts"],
      ":aws-nx-poc/game-ui": ["./packages/game-ui/src/index.ts"],
      ":aws-nx-poc/common-shadcn": ["./packages/common/shadcn/src/index.ts"],
      ":aws-nx-poc/common-shadcn/*": ["./packages/common/shadcn/src/*"],
      ":aws-nx-poc/infra": ["./packages/infra/src/index.ts"],
      ":aws-nx-poc/dynamodb": ["./packages/dynamodb/src/index.ts"]
    }
  }
}
