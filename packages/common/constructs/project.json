{
  "name": "@aws-nx-poc/common-constructs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/common/constructs/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        "aws_nx_poc.py_dynamo_db:build",
        "aws_nx_poc.api:build"
      ]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["generate:api-metadata"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{workspaceRoot}/coverage/{projectRoot}"
      }
    },
    "generate:api-metadata": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        {
          "dependentTasksOutputFiles": "**/*.json"
        }
      ],
      "outputs": [
        "{workspaceRoot}/packages/common/constructs/src/generated/api"
      ],
      "options": {
        "commands": [
          "nx g @aws/nx-plugin:open-api#ts-metadata --openApiSpecPath=\"dist/packages/api/openapi/openapi.json\" --outputPath=\"packages/common/constructs/src/generated/api\" --no-interactive"
        ]
      },
      "dependsOn": ["aws_nx_poc.api:openapi"]
    }
  }
}
