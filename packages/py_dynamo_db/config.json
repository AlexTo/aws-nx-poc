{
  "runtimeConfigKey": "PyDynamoDb",
  "serveLocal": {
    "port": 8000,
    "tableName": "aws-nx-poc-py-dynamo-db",
    "image": "public.ecr.aws/aws-dynamodb-local/aws-dynamodb-local:latest",
    "containerName": "aws-nx-poc-dynamodb",
    "containerEngine": "docker"
  },
  "tableConfig": {
    "globalSecondaryIndexes": [
      {
        "indexName": "gsi1pk-gsi1sk-index",
        "partitionKey": "gsi1pk",
        "sortKey": "gsi1sk"
      },
      {
        "indexName": "gsi2pk-gsi2sk-index",
        "partitionKey": "gsi2pk",
        "sortKey": "gsi2sk"
      }
    ]
  }
}
