{
  "name": "aws_nx_poc.py_dynamo_db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/py_dynamo_db/aws_nx_poc_py_dynamo_db",
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  },
  "tags": [],
  "metadata": {
    "generator": "py#dynamodb",
    "ports": [8000]
  },
  "targets": {
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "build": {
      "inputs": ["default", "^production"],
      "dependsOn": ["lint", "compile", "test", "typecheck"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}"
      }
    },
    "compile": {
      "executor": "@nxlv/python:build",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/build"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}/build",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "options": {
        "filePatterns": ["aws_nx_poc_py_dynamo_db", "tests"]
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "outputs": [],
      "options": {
        "lintFilePatterns": ["aws_nx_poc_py_dynamo_db", "tests"]
      },
      "cache": true,
      "inputs": ["default", "^production"],
      "configurations": {
        "fix": {
          "fix": true
        },
        "skip-lint": {
          "exitZero": true
        }
      },
      "dependsOn": ["format"]
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run ty check",
        "cwd": "{projectRoot}"
      }
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "pull-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python ../common/py-dynamodb/scripts/pull_image.py",
        "cwd": "{projectRoot}"
      }
    },
    "serve-local": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["pull-image"],
      "options": {
        "commands": [
          "uv run python ../common/py-dynamodb/scripts/start_container.py",
          "uv run python ../common/py-dynamodb/scripts/create_local_table.py"
        ],
        "parallel": true,
        "cwd": "{projectRoot}"
      }
    }
  }
}
